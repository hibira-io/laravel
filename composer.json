{
    "name": "hibira-io/laravel",
    "description": "Laravel broadcasting, push notifications and webhooks for Hibira, with one composer require",
    "keywords": [
        "laravel",
        "broadcasting",
        "websockets",
        "realtime",
        "push notifications",
        "echo",
        "hibira"
    ],
    "homepage": "https://hibira.io",
    "license": "MIT",
    "authors": [
        {
            "name": "Hibira",
            "homepage": "https://hibira.io"
        }
    ],
    "support": {
        "issues": "https://github.com/hibira-io/laravel/issues",
        "docs": "https://github.com/hibira-io/laravel#readme",
        "email": "support@hibira.io"
    },
    "require": {
        "php": "^7.1.3|^8.0",
        "illuminate/broadcasting": "^5.6|^6.0|^7.0|^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/console": "^5.6|^6.0|^7.0|^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^5.6|^6.0|^7.0|^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/notifications": "^5.6|^6.0|^7.0|^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^5.6|^6.0|^7.0|^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^5.6|^6.0|^7.0|^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "pusher/pusher-php-server": "^3.0|^4.0|^5.0|^6.0|^7.0",
        "pusher/pusher-push-notifications": "^1.1|^2.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.0",
        "orchestra/testbench": "^3.6|^4.0|^5.0|^6.0|^7.0|^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^7.5|^8.0|^9.0|^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Hibira\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hibira\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Hibira\\Laravel\\HibiraServiceProvider"
            ],
            "aliases": {
                "Hibira": "Hibira\\Laravel\\Facades\\Hibira",
                "HibiraPush": "Hibira\\Laravel\\Facades\\HibiraPush"
            }
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
